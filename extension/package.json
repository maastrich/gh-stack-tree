{
  "name": "gh-stack-tree",
  "description": "Render tree-shaped PR stacks on github.com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "license": "MIT",
  "author": "Mathis Pinsault",
  "repository": {
    "type": "git",
    "url": "https://github.com/maastrich/gh-stack-tree.git"
  },
  "homepage": "https://github.com/maastrich/gh-stack-tree#readme",
  "bugs": {
    "url": "https://github.com/maastrich/gh-stack-tree/issues"
  },
  "keywords": [
    "github",
    "pull-requests",
    "stacked-prs",
    "browser-extension",
    "wxt"
  ]
}
